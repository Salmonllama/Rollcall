# Rendered by install.sh into /opt/rollcall/Caddyfile. Edits there are overwritten by
# "install.sh update"; change this template instead.
#
# Caddy redirects HTTP to HTTPS on its own because the site address is a hostname.

{{HOSTNAME}} {
	{{TLS_DIRECTIVE}}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy app:8080
}
